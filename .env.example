# 仅服务身份配置；用户自行填写，AI 不应读取真实 .env 或 ~/.abilock。
ABILOCK_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS
ABILOCK_EXEC_TOKEN=REPLACE_WITH_EXECUTION_CAPABILITY_AT_LEAST_24_CHARS
# 默认使用服务身份的 ~/.abilock/；已有配置请显式填原数据目录，不会自动搬迁。
# ABILOCK_DATA_DIR=/absolute/path/to/existing/data
ABILOCK_ADMIN_PORT=4317
ABILOCK_EXEC_PORT=4318
# 管理密码首次在本机 UI 设置，无默认密码。
# ABILOCK_ADMIN_TOKEN 仅供已有旧令牌实例迁移；新实例不要配置。
# CLI 只使用已授予的执行能力与公开地址，不读取此文件或服务数据。
# ABILOCK_ENDPOINT=http://127.0.0.1:4318
# ABILOCK_ADMIN_URL=http://127.0.0.1:4317
# 正式运行不启用 ABILOCK_ALLOW_LOCAL / ABILOCK_MOCK。
# 旧环境变量仅作迁移 fallback，ABILOCK_* 优先；所有新配置使用 ABILOCK_*。
