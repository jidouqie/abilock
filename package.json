{
  "name": "abilock",
  "version": "2.2.11",
  "private": true,
  "type": "module",
  "description": "Abilock：为 AI 接入外部能力，统一保管凭据，通过 abl 发现与调用",
  "author": {
    "name": "吉豆茄 jidouqie",
    "url": "https://v.douyin.com/oApPI_L9avQ"
  },
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "abl": "bin/abl.mjs"
  },
  "files": [
    "bin/*.mjs",
    "bin/*.d.mts",
    "request-limits.json",
    "dist/request-limits.json",
    "native/*.c",
    "native/*.m",
    "native/file-lock",
    "native/prebuilt/**",
    "scripts/prepare-isolation.mjs",
    "scripts/build-isolation-launcher.mjs",
    "scripts/build-file-lock.mjs",
    "scripts/isolation-install.py",
    "scripts/verify-isolation.py",
    "npm-shrinkwrap.json",
    "src/**/*.ts",
    "dist/src/**/*.js",
    "dist/web/",
    "web/",
    "docs/*.md",
    "docs/protocols/*.md",
    "docs/providers/*.md",
    "docs/security/*.md",
    "deploy/README.md",
    "deploy/compose.yaml",
    "deploy/Dockerfile",
    "skills/abilock/SKILL.md",
    "skills/abilock/agents/openai.yaml",
    "skills/abilock/references/*.md",
    "examples/chat.json",
    "examples/mock.json",
    "examples/multipart.json",
    "examples/video-submit.json",
    "scripts/mock-mode.ts",
    "scripts/mock-upstream.ts",
    "tsconfig.json",
    "tsconfig.server.json",
    "tsconfig.bin.json",
    "vite.config.ts",
    "eslint.config.js",
    ".env.example",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "native/desktop/**",
    "native/windows/**",
    "scripts/windows/*.ps1",
    "scripts/windows/bootstrap-fixture/**",
    "scripts/windows/git-runtime.json",
    "scripts/build-desktop.mjs",
    "scripts/install-macos.sh",
    "desktop/macos/Abilock.app/**"
  ],
  "scripts": {
    "dev": "tsx src/start.ts",
    "dev:mock": "tsx scripts/mock-mode.ts",
    "build": "node scripts/build-file-lock.mjs && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/src/start.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.bin.json",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "tsx scripts/ui-check.ts",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "abl": "node bin/abl.mjs",
    "check:public": "node scripts/check-public-source.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-sts": "^3.1146.0",
    "@smithy/node-http-handler": "^4.12.1",
    "ipaddr.js": "^2.2.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "^6.3.0",
    "ssh2": "^1.17.0",
    "turndown": "^7.2.1",
    "ws": "^8.22.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.6",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.0",
    "playwright": "^1.56.0",
    "prettier": "3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0"
  },
  "license": "MIT"
}
